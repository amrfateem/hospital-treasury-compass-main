# Al-Rahma Hospital signed update script (generated; do not edit).
# It verifies every payload file by SHA-256, backs up the database, replaces the server
# and public folders, then starts the server again. A failure restores the previous version.
#Requires -RunAsAdministrator
$ErrorActionPreference = "Stop"
$Version = "__VERSION__"
$AppDir = $PSScriptRoot
for ($i = 0; $i -lt 4; $i++) {
  if (Test-Path (Join-Path $AppDir "AlRahmaHospital.exe")) { break }
  $AppDir = Split-Path $AppDir -Parent
}
if (-not (Test-Path (Join-Path $AppDir "AlRahmaHospital.exe"))) { throw "لم يتم العثور على مجلد البرنامج." }
$AppDir = (Resolve-Path $AppDir).Path
$Payload = Join-Path $PSScriptRoot "payload"
$Stamp = Get-Date -Format "yyyyMMdd-HHmmss"
$Backup = Join-Path $AppDir ("Backups\pre-update-" + $Stamp)
$ServiceName = "AlRahmaHospital"
$Hashes = __HASHES__

function Fail([string]$message) { throw "تحديث $Version فشل: $message" }

if (-not (Test-Path $Payload)) { Fail "مجلد payload غير موجود." }

foreach ($rel in $Hashes.Keys) {
  $file = Join-Path $Payload $rel
  if (-not (Test-Path -LiteralPath $file)) { Fail "ملف ناقص: $rel" }
  $actual = (Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant()
  if ($actual -ne $Hashes[$rel]) { Fail "بصمة ملف غير مطابقة: $rel" }
}

New-Item -ItemType Directory -Force -Path $Backup | Out-Null
Get-ChildItem -Path (Join-Path $AppDir "data") -Filter "hospital.db*" -File -ErrorAction SilentlyContinue |
  Copy-Item -Destination $Backup -Force
Write-Host "نسخة ما قبل التحديث: $Backup"

$service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
$wasService = $false
if ($service) {
  $wasService = $true
  Stop-Service -Name $ServiceName -Force
  (Get-Service -Name $ServiceName).WaitForStatus("Stopped", (New-TimeSpan -Seconds 30))
}

Get-CimInstance Win32_Process -Filter "Name = 'node.exe'" -ErrorAction SilentlyContinue |
  Where-Object { $_.CommandLine -and $_.CommandLine -like "*$AppDir*server*index.mjs*" } |
  ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }
Get-Process -Name "AlRahmaHospital" -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
Start-Sleep -Seconds 2

foreach ($name in @("server", "public", "tls")) {
  $current = Join-Path $AppDir $name
  $old = Join-Path $AppDir ("$name.old-" + $Version)
  if (Test-Path $old) { Remove-Item $old -Recurse -Force }
  if (Test-Path $current) { Rename-Item -Path $current -NewName (Split-Path $old -Leaf) }
  Copy-Item -Path (Join-Path $Payload $name) -Destination $current -Recurse
}

$rootFiles = @("AlRahmaHospital.exe", "WebView2Loader.dll")
foreach ($name in $rootFiles) {
  $source = Join-Path $Payload $name
  if (-not (Test-Path $source)) { continue }
  $current = Join-Path $AppDir $name
  $old = Join-Path $AppDir ("$name.old-" + $Version)
  if (Test-Path $old) { Remove-Item $old -Force }
  if (Test-Path $current) { Move-Item -Path $current -Destination $old -Force }
  Copy-Item -Path $source -Destination $current -Force
}

# Refresh the installed service XML so it uses the new tls-entry.mjs and port 443.
if ($wasService) {
  $installer = Join-Path $AppDir "install-service.ps1"
  if (Test-Path $installer) {
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File $installer | Out-Null
  }
}

function Start-Server {
  if ($wasService) {
    Start-Service -Name $ServiceName
  } else {
    Start-Process -FilePath (Join-Path $AppDir "AlRahmaHospital.exe") -WorkingDirectory $AppDir
  }
}

Start-Server
$ok = $false
for ($i = 0; $i -lt 40; $i++) {
  Start-Sleep -Milliseconds 500
  try {
    & curl.exe -k -f -s -m 2 "https://127.0.0.1/api/health" | Out-Null
    if ($LASTEXITCODE -eq 0) { $ok = $true; break }
  } catch { }
}

if (-not $ok) {
  Write-Host "فشل تشغيل الإصدار الجديد؛ العودة للنسخة السابقة..." -ForegroundColor Yellow
  if ($wasService) { Stop-Service -Name $ServiceName -Force -ErrorAction SilentlyContinue }
  foreach ($name in @("server", "public", "tls")) {
    $old = Join-Path $AppDir ("$name.old-" + $Version)
    if (Test-Path $old) {
      Remove-Item (Join-Path $AppDir $name) -Recurse -Force -ErrorAction SilentlyContinue
      Rename-Item -Path $old -NewName $name
    }
  }
  foreach ($name in $rootFiles) {
    $old = Join-Path $AppDir ("$name.old-" + $Version)
    if (Test-Path $old) {
      Remove-Item (Join-Path $AppDir $name) -Force -ErrorAction SilentlyContinue
      Move-Item -Path $old -Destination (Join-Path $AppDir $name) -Force
    }
  }
  Get-ChildItem -Path $Backup -Filter "hospital.db*" | Copy-Item -Destination (Join-Path $AppDir "data") -Force
  Start-Server
  Fail "لم يستجب السيرفر بعد التحديث وتمت الاستعادة."
}

Write-Host "تم تحديث النظام إلى $Version بنجاح." -ForegroundColor Green
Write-Host "النسخة السابقة محفوظة بجانب المجلدات باسم server.old-$Version و public.old-$Version و AlRahmaHospital.exe.old-$Version."
Set-Content -Path (Join-Path $PSScriptRoot "applied.txt") -Value ("{0} at {1}" -f $Version, (Get-Date -Format s)) -Encoding UTF8
Rename-Item -Path (Join-Path $PSScriptRoot "apply-update.ps1") -NewName ("applied-$Version.ps1") -Force -ErrorAction SilentlyContinue
Remove-Item (Join-Path $PSScriptRoot "payload") -Recurse -Force -ErrorAction SilentlyContinue
